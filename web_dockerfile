# Web 端镜像：只装核心 + Flask，不装 PyQt
FROM python:3.10-slim

WORKDIR /app

# NANO_BANANA_HOME：可写数据目录（配置、预设），挂一个卷到 /data 即可持久化
# NANO_BANANA_HOST：容器内必须监听 0.0.0.0，端口映射才能访问到
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NANO_BANANA_HOME=/data \
    NANO_BANANA_HOST=0.0.0.0 \
    NANO_BANANA_PORT=5000

COPY pyproject.toml README.md /app/
COPY src /app/src

# 非 editable 安装：静态前端、schema、内置预设都作为 package-data 装进 site-packages
RUN pip install --no-cache-dir ".[web]"

VOLUME ["/data"]
EXPOSE 5000

CMD ["python", "-m", "nano_banana.web"]
